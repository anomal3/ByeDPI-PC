<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ByeDpiPc.App.ViewModels"
             x:Class="ByeDpiPc.App.Views.LogsView"
             x:DataType="vm:LogsViewModel">
  <UserControl.Styles>
    <Style Selector="SelectableTextBlock.lvl">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="SelectableTextBlock.lvl.warn"><Setter Property="Foreground" Value="{DynamicResource WarningBrush}" /></Style>
    <Style Selector="SelectableTextBlock.lvl.err"><Setter Property="Foreground" Value="{DynamicResource DangerBrush}" /></Style>
    <Style Selector="SelectableTextBlock.lvl.dbg"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}" /></Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="32,26,32,28">
    <StackPanel Spacing="4" Margin="0,0,0,14">
      <TextBlock Classes="h1" Text="Логи" />
      <TextBlock Classes="muted" Text="Сообщения программы, ciadpi и sing-box. Файлы журнала хранятся 7 дней." />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
      <ComboBox ItemsSource="{Binding Levels}" SelectedIndex="{Binding LevelIndex}" Width="180" />
      <TextBox Grid.Column="1" Text="{Binding Search}" Watermark="Фильтр по тексту" Margin="10,0">
        <TextBox.InnerLeftContent>
          <PathIcon Data="{StaticResource Icon.Magnify}" Width="16" Height="16" Margin="10,0,0,0" Foreground="{DynamicResource MutedBrush}" />
        </TextBox.InnerLeftContent>
      </TextBox>
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
        <Button Classes="accent" Command="{Binding DiagnoseCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8"><PathIcon Data="{StaticResource Icon.MonitorDashboard}" /><TextBlock Text="Диагностика" /></StackPanel>
        </Button>
        <Button Classes="icon" Command="{Binding CopyCommand}" ToolTip.Tip="Скопировать"><PathIcon Data="{StaticResource Icon.ContentCopy}" /></Button>
        <Button Classes="icon" Command="{Binding OpenFolderCommand}" ToolTip.Tip="Открыть папку с логами"><PathIcon Data="{StaticResource Icon.FolderOpenOutline}" /></Button>
        <Button Classes="icon" Command="{Binding ClearCommand}" ToolTip.Tip="Очистить"><PathIcon Data="{StaticResource Icon.DeleteOutline}" /></Button>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Classes="card" Padding="4" Background="{DynamicResource CodeBgBrush}">
      <Grid RowDefinitions="*,Auto">
        <ListBox Name="List" ItemsSource="{Binding Items}" Background="Transparent">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="10,3" />
              <Setter Property="MinHeight" Value="0" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:LogItem">
              <Grid ColumnDefinitions="70,120,*">
                <TextBlock Classes="mono caption" Text="{Binding Time}" />
                <TextBlock Grid.Column="1" Classes="mono caption" Text="{Binding Source}" TextTrimming="CharacterEllipsis" Margin="0,0,10,0" />
                <SelectableTextBlock Grid.Column="2" Classes="mono lvl" Classes.warn="{Binding IsWarning}" Classes.err="{Binding IsError}" Classes.dbg="{Binding IsDebug}" Text="{Binding Message}" TextWrapping="Wrap" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <CheckBox Grid.Row="1" IsChecked="{Binding AutoScroll}" Content="Прокручивать к новым" Margin="10,4" FontSize="12" />
      </Grid>
    </Border>
  </Grid>
</UserControl>

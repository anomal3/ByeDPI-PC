<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="BgColor">#F3F5F9</Color>
      <Color x:Key="SidebarColor">#EBEEF4</Color>
      <Color x:Key="SurfaceColor">#FFFFFF</Color>
      <Color x:Key="Surface2Color">#F1F3F8</Color>
      <Color x:Key="HoverColor">#E6EAF2</Color>
      <Color x:Key="BorderColor">#E0E4EC</Color>
      <Color x:Key="TextColor">#151922</Color>
      <Color x:Key="MutedColor">#5D6678</Color>
      <Color x:Key="AccentColor">#3366FF</Color>
      <Color x:Key="AccentSoftColor">#E6EDFF</Color>
      <Color x:Key="SuccessColor">#16A34A</Color>
      <Color x:Key="SuccessSoftColor">#E3F6EA</Color>
      <Color x:Key="WarningColor">#D97706</Color>
      <Color x:Key="WarningSoftColor">#FDF1DC</Color>
      <Color x:Key="DangerColor">#E5484D</Color>
      <Color x:Key="DangerSoftColor">#FDE7E8</Color>
      <Color x:Key="IdleColor">#9AA3B5</Color>
      <Color x:Key="ShadowColor">#1A1F2B3D</Color>
      <Color x:Key="CodeBgColor">#F4F6FA</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="BgColor">#101218</Color>
      <Color x:Key="SidebarColor">#0B0D12</Color>
      <Color x:Key="SurfaceColor">#181B23</Color>
      <Color x:Key="Surface2Color">#1F232D</Color>
      <Color x:Key="HoverColor">#262B37</Color>
      <Color x:Key="BorderColor">#2A2F3B</Color>
      <Color x:Key="TextColor">#E9ECF3</Color>
      <Color x:Key="MutedColor">#9AA3B4</Color>
      <Color x:Key="AccentColor">#6690FF</Color>
      <Color x:Key="AccentSoftColor">#1D2741</Color>
      <Color x:Key="SuccessColor">#22C55E</Color>
      <Color x:Key="SuccessSoftColor">#13291D</Color>
      <Color x:Key="WarningColor">#F5B83D</Color>
      <Color x:Key="WarningSoftColor">#2E2512</Color>
      <Color x:Key="DangerColor">#F87171</Color>
      <Color x:Key="DangerSoftColor">#311A1C</Color>
      <Color x:Key="IdleColor">#5C6475</Color>
      <Color x:Key="ShadowColor">#66000000</Color>
      <Color x:Key="CodeBgColor">#14171E</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="BgBrush" Color="{DynamicResource BgColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{DynamicResource SidebarColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{DynamicResource SurfaceColor}" />
  <SolidColorBrush x:Key="Surface2Brush" Color="{DynamicResource Surface2Color}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource HoverColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource MutedColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{DynamicResource AccentSoftColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{DynamicResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{DynamicResource SuccessSoftColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{DynamicResource WarningColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{DynamicResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{DynamicResource DangerColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{DynamicResource DangerSoftColor}" />
  <SolidColorBrush x:Key="IdleBrush" Color="{DynamicResource IdleColor}" />
  <SolidColorBrush x:Key="CodeBgBrush" Color="{DynamicResource CodeBgColor}" />

  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>
  <CornerRadius x:Key="CardRadius">14</CornerRadius>
  <CornerRadius x:Key="ControlRadius">9</CornerRadius>
</ResourceDictionary>
